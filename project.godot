; Underworld strategy simulation prototype.
config_version=5

[application]
config/name="Underworld — Simulation Prototype"
config/version="0.2.0-dev"
config/icon="res://game/assets/underworld_icon.svg"
run/max_fps=30
boot_splash/show_image=false
boot_splash/bg_color=Color(0.216, 0.157, 0.125, 1)
run/main_scene="res://game/ui/mobile.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.063, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
limits/opengl/max_renderable_lights=8
limits/opengl/max_renderable_lights.mobile=8
limits/opengl/max_lights_per_object=4
limits/opengl/max_lights_per_object.mobile=4
